{
  "name": "bd-autohost-bot",
  "version": "1.0.0",
  "description": "-",
  "type": "module",
  "main": "dist/test-app.js",
  "scripts": {
    "build": "bun build test-app.ts --target=node --outfile=dist/test-app.js",
    "build:bot": "bun build src/index.ts --target=bun --outfile=dist/index.js",
    "start": "node dist/test-app.js",
    "dev": "tsx watch test-app.ts",
    "testapp": "tsx watch test-app.ts",
    "bot": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "check-updates": "tsx src/sheets/check-updates.ts",
    "maps": "bun scripts/import-volunteer-maps.ts",
    "maps:seed": "node mapeditor/seed.cjs",
    "maps:editor": "node mapeditor/server.cjs"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
