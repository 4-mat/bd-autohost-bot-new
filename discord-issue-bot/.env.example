# Discord bot application
DISCORD_TOKEN=
CLIENT_ID=
# Guild ID for instant slash-command registration (recommended during setup).
# Leave unset to register commands globally.
GUILD_ID=

# GitHub personal access token with `issues: write` (or fine-grained token for
# this repo only) -- used to create issues on the target repo.
GITHUB_TOKEN=
# Owner/repo the bot creates issues in (default: 4-mat/bd-autohost-bot-new)
GITHUB_REPO=4-mat/bd-autohost-bot-new

# Role gate: only members with this role can use the bot.
# Set ROLE_ID (preferred) or ROLE_NAME.
ROLE_ID=
ROLE_NAME=super turbo
